          ],
          [
            "Stok Habis",
            "=COUNTIF(Master_Obat!J2:J,\"<=0\")"
          ],
          [
            "Nilai Persediaan (HPP)",
            "=SUMPRODUCT(Master_Obat!J2:J,Master_Obat!G2:G)"
          ],
          [
            "Total Pengeluaran Pembelian (Rp)",
            "=SUM(Riwayat_Pembelian!D2:D*Riwayat_Pembelian!F2:F)"
