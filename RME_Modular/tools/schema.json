{
  "PASIEN": {
    "title": "RME Sheldon - 01 Pasien",
    "sheets": [
      {
        "name": "Data_Pasien",
        "headers": [
          "ID_Pasien",
          "Nama_Pasien",
          "No_RM",
          "Jenis_Kelamin",
          "Tempat_Lahir",
          "Tanggal_Lahir",
          "Umur",
          "Agama",
          "Golongan_Darah",
          "Pekerjaan",
          "NIK",
          "Alamat",
          "Provinsi",
          "Kabupaten",
          "Kecamatan",
          "Kelurahan",
          "WhatsApp",
          "Alergi",
          "Riwayat_Penyakit",
          "Catatan",
          "Tanggal_Daftar"
        ],
        "formats": {
          "Tanggal_Lahir": "dd-mm-yyyy",
          "Tanggal_Daftar": "dd-mm-yyyy",
          "NIK": "@",
          "WhatsApp": "@"
        },
        "validations": {
          "Jenis_Kelamin": [
            "Laki-Laki",
            "Perempuan"
          ],
          "Agama": [
            "Islam",
            "Kristen",
            "Katolik",
            "Hindu",
            "Buddha",
            "Khonghucu"
          ],
          "Golongan_Darah": [
            "A",
            "B",
            "AB",
            "O"
          ]
        },
        "rows": []
      },
      {
        "name": "Statistik_Pasien",
        "kind": "formula",
        "grid": [
          [
            "Metrik",
            "Nilai",
            "",
            "No_RM",
            "Nama_Pasien",
            "Umur_Saat_Ini"
          ],
          [
            "Total Pasien",
            "=COUNTA(Data_Pasien!A2:A)",
            "",
            "={\"\",\"\",\"\";ARRAYFORMULA(IF(Data_Pasien!A2:A=\"\",\"\",{Data_Pasien!C2:C,Data_Pasien!B2:B,IFERROR(DATEDIF(Data_Pasien!F2:F,TODAY(),\"Y\")&\" Tahun\",\"-\")}))}"
          ],
          [
            "Laki-Laki",
            "=COUNTIF(Data_Pasien!D2:D,\"Laki-Laki\")"
          ],
          [
            "Perempuan",
            "=COUNTIF(Data_Pasien!D2:D,\"Perempuan\")"
          ],
          [
            "Pasien Baru Bulan Ini",
            "=COUNTIFS(Data_Pasien!U2:U,\">=\"&(EOMONTH(TODAY(),-1)+1),Data_Pasien!U2:U,\"<=\"&EOMONTH(TODAY(),0))"
          ],
          [
            "Rata-rata Umur (Tahun)",
            "=IFERROR(ROUND(AVERAGE(FILTER(DATEDIF(Data_Pasien!F2:F,TODAY(),\"Y\"),ISNUMBER(Data_Pasien!F2:F))),1),\"-\")"
          ],
          [
            "Anak (< 12 th)",
            "=IFERROR(SUMPRODUCT(ISNUMBER(Data_Pasien!F2:F)*(IFERROR(DATEDIF(Data_Pasien!F2:F,TODAY(),\"Y\"),999)<12)),0)"
          ],
          [
            "Remaja (12-17 th)",
            "=IFERROR(SUMPRODUCT(ISNUMBER(Data_Pasien!F2:F)*(IFERROR(DATEDIF(Data_Pasien!F2:F,TODAY(),\"Y\"),-1)>=12)*(IFERROR(DATEDIF(Data_Pasien!F2:F,TODAY(),\"Y\"),999)<18)),0)"
          ],
          [
            "Dewasa (18-59 th)",
            "=IFERROR(SUMPRODUCT(ISNUMBER(Data_Pasien!F2:F)*(IFERROR(DATEDIF(Data_Pasien!F2:F,TODAY(),\"Y\"),-1)>=18)*(IFERROR(DATEDIF(Data_Pasien!F2:F,TODAY(),\"Y\"),999)<60)),0)"
          ],
          [
            "Lansia (>= 60 th)",
            "=IFERROR(SUMPRODUCT(ISNUMBER(Data_Pasien!F2:F)*(IFERROR(DATEDIF(Data_Pasien!F2:F,TODAY(),\"Y\"),-1)>=60)),0)"
          ]
        ]
      }
    ]
  },
  "PEMBAYARAN": {
    "title": "RME Sheldon - 02 Pembayaran",
    "sheets": [
      {
        "name": "Data_Pembayaran",
        "headers": [
          "ID_Invoice",
          "Tanggal_Tindakan",
          "ID_Pasien",
          "No_RM",
          "Nama_Pasien",
          "Dokter_Pemeriksa",
          "Kategori_Item",
          "Nama_Item",
          "Harga_Satuan",
          "Qty",
          "Labor",
          "Diskon_Persen",
          "Grand_Total_Item",
          "Perawat",
          "Total_Invoice",
          "Metode_Bayar",
          "Status_Pembayaran",
          "Keterangan",
          "Kasir_Bertugas",
          "Waktu_Sistem"
        ],
        "formats": {
          "Tanggal_Tindakan": "dd-mm-yyyy",
          "Harga_Satuan": "#,##0",
          "Labor": "#,##0",
          "Grand_Total_Item": "#,##0",
          "Total_Invoice": "#,##0",
          "Waktu_Sistem": "dd-mm-yyyy hh:mm:ss"
        },
        "validations": {
          "Kategori_Item": [
            "Tindakan",
            "Obat",
            "BMHP"
          ],
          "Metode_Bayar": [
            "Tunai",
            "Transfer Bank",
            "QRIS",
            "Kartu Debit/Kredit",
            "Asuransi"
          ],
          "Status_Pembayaran": [
            "Lunas",
            "Uang Muka",
            "Pelunasan"
          ]
        },
        "rows": []
      },
      {
        "name": "Rekap_Invoice",
        "kind": "formula",
        "note": "1 baris = 1 invoice. Kolom K mengaudit Total_Invoice vs jumlah Grand_Total_Item.",
        "grid": [
          [
            "=QUERY(Data_Pembayaran!A1:T,\"select A, B, E, F, max(O), P, Q, S, sum(M), count(H) where A is not null group by A, B, E, F, P, Q, S order by B desc label max(O) 'Total_Invoice', sum(M) 'Total_Item', count(H) 'Jumlah_Item'\",1)",
            "",
            "",
            "",
            "",
            "",
            "",
            "",
            "",
            "",
            "={\"Audit\";ARRAYFORMULA(IF(A2:A=\"\",\"\",IF(E2:E=I2:I,\"OK\",\"SELISIH\")))}"
          ]
        ]
      },
      {
        "name": "Rekap_Harian",
        "kind": "formula",
        "grid": [
          [
            "=IFERROR(QUERY(Rekap_Invoice!A1:J,\"select B, count(A), sum(E) where A is not null group by B order by B desc label count(A) 'Jumlah_Invoice', sum(E) 'Total_Pendapatan'\",1),\"Belum ada transaksi\")",
            "",
            "",
            "",
            "=IFERROR(QUERY(Rekap_Invoice!A1:J,\"select year(B), month(B)+1, count(A), sum(E) where B is not null group by year(B), month(B)+1 order by year(B) desc, month(B)+1 desc label year(B) 'Tahun', month(B)+1 'Bulan', count(A) 'Jumlah_Invoice', sum(E) 'Total_Pendapatan'\",1),\"Kolom Tanggal_Tindakan harus berformat tanggal\")"
          ]
        ]
      },
      {
        "name": "Rekap_Metode_Dokter",
        "kind": "formula",
        "grid": [
          [
            "=IFERROR(QUERY(Rekap_Invoice!A1:J,\"select F, count(A), sum(E) where A is not null group by F order by sum(E) desc label count(A) 'Jumlah_Invoice', sum(E) 'Total'\",1),\"-\")",
            "",
            "",
            "",
            "=IFERROR(QUERY(Data_Pembayaran!A1:T,\"select F, G, sum(J), sum(M) where A is not null group by F, G order by F label sum(J) 'Total_Qty', sum(M) 'Total_Omzet'\",1),\"-\")",
            "",
            "",
            "",
            "",
            "=IFERROR(QUERY(Data_Pembayaran!A1:T,\"select N, count(H), sum(M) where G = 'Tindakan' and N is not null and N <> '' group by N order by count(H) desc label count(H) 'Jumlah_Tindakan', sum(M) 'Total_Omzet'\",1),\"-\")"
          ]
        ]
      },
      {
        "name": "Rekap_Item",
        "kind": "formula",
        "grid": [
          [
            "=IFERROR(QUERY(Data_Pembayaran!A1:T,\"select G, H, sum(J), sum(M) where A is not null group by G, H order by sum(M) desc label sum(J) 'Total_Qty', sum(M) 'Total_Omzet'\",1),\"-\")"
          ]
        ]
      }
    ]
  },
